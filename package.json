{
  "name": "penpotqa",
  "version": "1.0.0",
  "description": "QA Test for Penpot",
  "main": "index.js",
  "scripts": {
    "open": " npx playwright test --ui",
    "test": "npx playwright test --project=chrome",
    "changed": "npx playwright test --project=chrome --only-changed",
    "test:enterprise": "npx playwright test --project=enterprise --workers=8",
    "testLogin": "npx playwright test --project=chrome ./tests/panels-features/panels-features-fill.spec.js",
    "updateSnapshots": "npx playwright test --project=chrome --update-snapshots",
    "test:docker": "docker compose run --rm playwright",
    "test:docker:ui": "docker compose run --rm --service-ports playwright-ui",
    "prettier": "npx prettier --write .",
    "prepare": "husky",
    "cleanup:stripe:dry-run": "tsx scripts/cleanup-stripe-test-customers.ts",
    "cleanup:stripe:execute": "tsx scripts/cleanup-stripe-test-customers.ts --execute"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penpot/penpotqa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/penpot/penpotqa/issues"
  },
  "homepage": "https://github.com/penpot/penpotqa#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testdino/playwright": "^2.6.2",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "playwright-qase-reporter": "^2.7.0",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "fs": "^0.0.1-security",
    "googleapis": "^181.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "qaseio": "^2.4.3",
    "stripe": "^22.6.2",
    "ts-node": "^10.9.2"
  }
}
